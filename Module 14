class Employee:
  
  def __init__(self, first, last, pay):
      self.first = first
      self.last = last
      self.pay = pay
      self.email = first + ' . ' + last + '@company.com'

  def fullname(self):
      return '{} {}'.format(self.first, self.last)

  def calculated_bounus(self, bonus_rate):
      return self.pay * bonus_rate

    
emp_1 = Employee('Corey', 'Schafer', 50000)
emp_2 = Employee('Test', 'User', 60000)

emp_1.fullname()
print(Employee.fullname(emp_1))
emp_2.fullname()
print(Employee.fullname(emp_2))

rate = 0.10
print(f"{emp_1.fullname()} bonus: {emp_1.calculated_bonus(rate)}")
print(f"{emp_2.fullname()} bonus: {emp_2.calculated_bonus(rate)}")


class Student:
  
  def __init__(self, first, last, district_code, credits):
      self.first = first
      self.last = last
      self.district_code = district_code
      self.credits = credits

  def fullname(self):
      return f"{self.first} {self.last}"
    
  def compute_tuition(self):

      if self.district_code == 'I':
          rate = 250
      else:
           rate = 500
      return self.credits * rate
    
student1 = Student('Alice', 'Smith', 'I', 12)
student2 = Student('Bob', 'Jones', 'O', 13)

print(f"{student1.fullname()} tuititon owed: ${student1.compute_tuition()}")
print(f"{student2.fullname()} tuition owed: ${student2.compute_tuition()}")


class Student: 

    DISTRICT_RATES = {
        'X': 800.00
        'G': 250.00
        '0': 500.00
}

def __init__(self, first, last, district_code, credits):
      self.first = first
      self.last = last
      self.district_code = district_code
      self.credits = credits

  def fullname(self):
      return f"{self.first} {self.last}"
    
  def compute_tuition(self):

      rate = self.DISTRICT_RATES.get(self.district_code, 500)
      return self.credits * rate

student1 = Student('Alice', 'Smith', 'X', 12)
student2 = Student('Bob', 'Jones', 'O', 13)
student3 = Student('Chralie', 'Brown', 'G', 10)

print(f"{student1.fullname()} tuititon owed: ${student1.compute_tuition()}")
