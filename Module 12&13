student_data = {
    "Alice": 85,
    "Bob": 92,
    "Charlie": 78,
    "Diana": 95,
    "Ethan": 88
}

def print_student_grades(data):
    print(f"{'Student Name':<15} | {'Grade':<5}")
    print("-" * 25)

    if not data:
        print("No student grades available.")
        return

    total_grade = 0
    for name, grade in data.items():
        print(f"{name:<15} | {grade:<5}")
        total_grade += grade

    avg_grade = total_grade / len(data)
    print("-" * 25)
    print(f"{'Class Average':<15} | {avg_grade:<5.2f}")

print("Problem 4 Output:")
print_student_grades(student_data)
        


student_multi_grades = {
    "Alice Smith": [85, 90, 88],
    "Bob Jones": [92, 88, 94],
    "Charlie Brown": [78, 80, 82],
    "David Miller": [95, 92, 98],
    "Eve Davis": [88, 85, 90],
}


def print_multi_grade_stats(data):
    print(f"{'Student Name':<15} | {'Grades':<15} | {'Average':<7}")
    print("-" * 45)

    class_averages = []

    for name, grades in data.items():
        if not grades:
            print(f"{name:<15} | {'[]':<15} | {'N/A':<7}")
            continue

        avg = sum(grades) / len(grades)
        class_averages.append(avg)
        print(f"{name:<15} | {str(grades):<15} | {avg:<7.2f}")

    print("-" * 45)

    if class_averages:
        class_avg = sum(class_averages) / len(class_averages)
        print(f"Class Average for all students: {class_avg:.2f}")
    else:
        print("Class Average for all students: N/A")


print("\nProblem 5 Output:")
print_multi_grade_stats(student_multi_grades)



