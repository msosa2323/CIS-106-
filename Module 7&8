def calculate_tuition():
    student_data = []
    while True:
        user_input = input("Do you want to continue? (Yes/No): ")
        if user_input.strip().lower() != "yes":
            break

        last_name = input("Enter student last name: ").strip()
        district_code = input("Enter district code (I or O): ").strip().upper()

        if district_code == "I":
            cost_per_credit = 500.00
        elif district_code == "O":
            cost_per_credit = 750.00
        else:
            print("Invalid district code. Please enter 'I' or 'O'.")
            continue

        try:
            credits = int(input("Enter number of credits taken: "))
            if credits < 0:
                print("Credits cannot be negative. Please try again.")
                continue
        except ValueError:
            print("Invalid input. Credits must be an integer.")
            continue

        tuition_owed = credits * cost_per_credit
        student_data.append({"name": last_name, "tuition": tuition_owed})

    if not student_data:
        print("No student data entered.")
        return

    print("\n--- Tuition Summary ---")
    for student in student_data:
        print(f"Student: {student['name']}, Tuition Owed: ${student['tuition']:.2f}")

    print(f"\nTotal number of students processed: {len(student_data)}")


if __name__ == "__main__":
    calculate_tuition()

