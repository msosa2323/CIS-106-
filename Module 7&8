def process_order_data(filename="orders.txt"):
    """Process order data from a text file.

    Args:
        filename(str): The name of the text file containing order data.
                       Each order should be represented by three lines:
                       item name, quantity, and price.
    """
    total_extended_price = 0
    order_count = 0 
    
    try:
        with open(filename, 'r') as f:
            lines = [line.strip() for line in f]

        i = 0
        while i < len(lines):
            item = lines[i] 
            quantity = int(lines[i+1])
            price = float(lines[i+2])

            extended_price = quantity * price
            total_extended_price += extended_price
            order_count += 1 

            print(f"Item: {item}, Quantity: {quantity}, Price: ${price:.2f}, Extended Price: ${extended_price:.2f}")

            i += 3
        average_order_price = total_extended_price / order_count if order_count > 0 else 0 

        print("\n--- Order Summary ---")
        print(f"Total Extended Price: ${total_extended_price:.2f}")
        print(f"Number of Orders: {order_count}")
        print(f"Average Order Price: ${average_order_price:.2f}")

    except FileNotFoundError:
        print(f"Error: The file '{filename}' was not found.")
    except ValueError:
        print("Error: Ensure quantity and price are valid numbers in the file.")
    except IndexError:
        print("Error: Incomplete data for an order in the file. Ensure each item has quantity and price.")

