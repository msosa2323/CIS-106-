 def student_exam_program():

     continue_program = input("Do you want to start the student exam program? (Yes/No): ").strip().lower()

    student_count = 0
    total_exam_score = 0.0 

    while continue_program == "yes":
        student_count += 1

        last_name = input("Enter student's last name: ").strip()
        try:
            exam1 = float(input(f"Enter first exam score for {last_name}: ").strip()
            exam2 = float(input(f"Enter second exam score for {last_name}: ").strip()

            average_score = (exam1 + exam2) / 2.0

            print(f"Student: {last_name}, Average Exam Score: {average_score:.2f}")

            total_exam_score += average_score 

