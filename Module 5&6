principle = float(input("Enter the principle amount: "))
years = int(input("Enter the years to maturity: "))

interest_rate = 0.0

if principle > 100000:
    if years == 5:
        interest_rate = 0.06
    elif years == 10:
        interest_rate = 0.05
    else:
        interest_rate = 0.02
if 50000 <= principle <= 100000:
    if years == 5:
        interest_rate = 0.04
    elif years == 10:
        interest_rate = 0.03
    else:
        interest_rate = 0.02
else:
    interest_rate = 0.02

first_year_interest = principle * interest_rate
print(f"Principle: ${principle:.2f}")
print(f"Interest Rate: {interest_rate:.0%}")
print(f"First Year Interest: ${first_year_interest:,.2f}")

