def calculated_forecast(month, sales):
    if month in ["Jan", "Feb", "Mar"]:
        forecast_percent = 0.10
    elif month in ["Apr", "May", "Jun"]:
        forcast_percent = 0.15
    elif month in ["Jul", "Aug", "Sep"]:
        forcast_percent = 0.20
    elif month in ["Oct", "Nov", "Dec"]:
        forcast_percent = 0.25
    else:
        return "Invalid month"
    next_month_sales = sales * (1 + forecast_percent)
    return next_month_sales

def calculate_out_the_door_price(msrp, make, model, electric_code):
    if make == "Honda" and model == "Accord":
        percent_off_mrsp = 0.10
    elif make == "Toyota" and model == "Rav4':
        percent_off_mrsp = 0.15
    elif electric_code == "Y":
        percent_off_mrsp = 0.30 
    else:
        percent_off_mrsp = 0.05

    new_mrsp = mrsp * (1 - percent_off_mrsp)
    sales_tax = new_msrp * 0.07
    total_price = new_msrp + sales_tax
    return total_price

def calculated_discount(quantity, price, discount_rate):
    discount_amount = quantity * price * discount_rate 
    discounted_price = quantity * price - discount_amount 
    return discount_amount, discounted_price

